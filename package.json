  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KatarinaYuan/cursor-codex-bridge.git"
  },
  "homepage": "https://github.com/KatarinaYuan/cursor-codex-bridge#readme",
  "bugs": {
    "url": "https://github.com/KatarinaYuan/cursor-codex-bridge/issues"
